  "credentialPatterns": {
    "content": [
      {
        "label": "an OpenGame creator token",
        "pattern": "\\bog[at]_[0-9a-f]{16}_[A-Za-z0-9_-]{43}\\b",
        "flags": ""
      },
      {
        "label": "an AWS access key id",
        "pattern": "\\b(?:AKIA|ASIA|AGPA|AIDA|AROA|ANPA|ANVA|APKA)[0-9A-Z]{16}\\b",
        "flags": ""
      },
      {
        "label": "an AWS secret access key",
        "pattern": "aws[_-]?secret[_-]?access[_-]?key\\s*[:=]\\s*\\S{20,}",
        "flags": "i"
      },
      {
        "label": "a GitHub token",
        "pattern": "\\bgh[pousr]_[A-Za-z0-9]{36,}\\b",
        "flags": ""
      },
      {
        "label": "a GitHub fine-grained token",
        "pattern": "\\bgithub_pat_[A-Za-z0-9_]{40,}\\b",
        "flags": ""
      },
      {
        "label": "an Anthropic API key",
        "pattern": "\\bsk-ant-[A-Za-z0-9_\\-]{20,}",
        "flags": ""
      },
      {
        "label": "an OpenAI API key",
        "pattern": "\\bsk-(?:proj-)?[A-Za-z0-9_\\-]{32,}",
        "flags": ""
      },
      {
        "label": "a Stripe secret key",
        "pattern": "\\b[sr]k_(?:live|test)_[A-Za-z0-9]{16,}\\b",
        "flags": ""
      },
      {
        "label": "a Slack token",
        "pattern": "\\bxox[abposr]-[A-Za-z0-9\\-]{10,}\\b",
        "flags": ""
      },
      {
        "label": "a Google API key",
        "pattern": "\\bAIza[0-9A-Za-z_\\-]{35}\\b",
        "flags": ""
      },
      {
        "label": "a private key block",
        "pattern": "-----BEGIN (?:[A-Z0-9 ]+ )?PRIVATE KEY-----(?:[ \\t\\r\\n]|\\\\+(?:[rnt]|u000[aAdD]|x0[aAdD])|<[bB][rR] ?/?>|[\"'`][ \\t\\r\\n]*(?:[+,][ \\t\\r\\n]*)?[\"'`])*[A-Za-z0-9+/]{4}",
        "flags": "",
        "parts": {
          "bannerOpen": "-----BEGIN ",
          "keyType": "[A-Z0-9 ]",
          "bannerClose": "PRIVATE KEY-----",
          "separator": "[ \\t\\r\\n]|\\\\+(?:[rnt]|u000[aAdD]|x0[aAdD])|<[bB][rR] ?/?>|[\"'`][ \\t\\r\\n]*(?:[+,][ \\t\\r\\n]*)?[\"'`]",
          "body": "[A-Za-z0-9+/]",
          "bodyMin": 4
        }
      },
      {
        "label": "a Supabase service-role key name",
        "pattern": "SUPABASE_SERVICE_ROLE(?:_KEY)?\\s*[:=]",
        "flags": "i"
      },
      {
        "label": "a Twilio auth token",
        "pattern": "\\bSK[0-9a-fA-F]{32}\\b",
        "flags": ""
      },
      {
        "label": "a SendGrid API key",
        "pattern": "\\bSG\\.[A-Za-z0-9_\\-]{16,}\\.[A-Za-z0-9_\\-]{16,}\\b",
        "flags": ""
      }
    ],
    "suspicious": [
      {
        "label": "a private key header without its key beside it",
        "pattern": "-----BEGIN (?:[A-Z0-9 ]+ )?PRIVATE KEY-----(?!(?:[ \\t\\r\\n]|\\\\+[rn]|\\x00)*(?:-----END|\\x00|$))",
        "flags": ""
      },
      {
        "label": "an assignment that looks like a secret",
        "pattern": "\\b(?:api[_-]?key|secret[_-]?key|access[_-]?token|auth[_-]?token|client[_-]?secret|private[_-]?key)\\s*[:=]\\s*['\"][^'\"\\s]{16,}['\"]",
        "flags": "i"
      }
    ]
  },
