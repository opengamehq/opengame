{
  "bundle": {
    "archiveBytesMax": 1073741824,
    "uncompressedBytesMax": 1610612736,
    "fileBytesMax": 268435456,
    "fileCountMax": 10000,
    "compressionRatioMax": 200,
    "entryPoint": "index.html",
    "pathBytesMax": 768
  },
  "catalogue": {
    "searchTagsMax": 12,
    "searchTagCharsMax": 60
  },
  "viewports": [
    {
      "label": "1080p",
      "width": 1920,
      "height": 1080,
      "primary": true
    },
    {
      "label": "laptop",
      "width": 1366,
      "height": 768
    },
    {
      "label": "qhd",
      "width": 2560,
      "height": 1440
    },
    {
      "label": "ultrawide",
      "width": 3440,
      "height": 1440
    },
    {
      "label": "small",
      "width": 1024,
      "height": 640
    }
  ],
  "checks": [
    {
      "key": "malware",
      "kind": "auto",
      "blocking": true,
      "label": "Malware scan",
      "hint": "ClamAV over the archive"
    },
    {
      "key": "archive",
      "kind": "auto",
      "blocking": true,
      "label": "Archive is safe to open",
      "hint": "Quotas, traversal, symlinks, ratio"
    },
    {
      "key": "entry",
      "kind": "auto",
      "blocking": true,
      "label": "index.html at root",
      "hint": "After root-directory normalisation"
    },
    {
      "key": "boot",
      "kind": "auto",
      "blocking": true,
      "label": "Boots and renders",
      "hint": "A frame within 30s"
    },
    {
      "key": "net",
      "kind": "auto",
      "blocking": true,
      "label": "No disallowed origins",
      "hint": "Blocked services and CSP refusals during the run"
    },
    {
      "key": "size",
      "kind": "auto",
      "blocking": false,
      "label": "Initial download",
      "hint": "Bytes before first playable frame"
    },
    {
      "key": "tti",
      "kind": "auto",
      "blocking": false,
      "label": "Time to playable",
      "hint": "og:ready, or frame-stability heuristic"
    },
    {
      "key": "mem",
      "kind": "auto",
      "blocking": false,
      "label": "Peak memory",
      "hint": "Over a three minute run"
    },
    {
      "key": "fps",
      "kind": "auto",
      "blocking": false,
      "label": "Frame rate",
      "hint": "Median at 1080p on a known GPU"
    },
    {
      "key": "desktop",
      "kind": "auto",
      "blocking": false,
      "label": "Works at every size",
      "hint": "Five viewports, responds to resize"
    },
    {
      "key": "content",
      "kind": "manual",
      "blocking": true,
      "label": "Content and conduct",
      "hint": "Scanned and playtested automatically"
    },
    {
      "key": "engine",
      "kind": "manual",
      "blocking": true,
      "label": "Declared engine",
      "hint": "Matches what the bundle actually loads"
    },
    {
      "key": "ip",
      "kind": "manual",
      "blocking": true,
      "label": "Originality and IP",
      "hint": "Declared by the creator, and removed on a valid DMCA notice"
    },
    {
      "key": "fresh",
      "kind": "manual",
      "blocking": true,
      "label": "Built after kickoff",
      "hint": "Attested by the creator"
    }
  ],
  "allowedGameOrigins": {
    "self": true,
    "api": "https://api.opengame.gg",
    "rtc": "wss://rtc.opengame.gg",
    "rtcHttps": "https://rtc.opengame.gg"
  },
  "trustedGameAssetOrigins": {
    "style": [
      "https://fonts.googleapis.com"
    ],
    "font": [
      "https://fonts.gstatic.com"
    ]
  },
  "gamePolicy": {
    "categories": {
      "payments": {
        "label": "payments",
        "rule": "Games on OpenGame are free to play. A game may not take money, tips, donations or card details, or send players to a page that does."
      },
      "crypto": {
        "label": "crypto",
        "rule": "Games on OpenGame may not use crypto wallets, tokens, NFTs or blockchains, and may not mine."
      },
      "accounts": {
        "label": "accounts",
        "rule": "Players start playing without making an account, signing in, or giving an email address. OpenGame gives every game a player through the SDK, so a game never needs its own sign-in."
      },
      "ads": {
        "label": "ads",
        "rule": "Games on OpenGame may not show ads. A portal SDK such as Poki's or CrazyGames' serves ads, so remove it."
      },
      "tracking": {
        "label": "tracking",
        "rule": "Games on OpenGame may not carry ad pixels or session recording. Use the SDK's events for analytics."
      }
    },
